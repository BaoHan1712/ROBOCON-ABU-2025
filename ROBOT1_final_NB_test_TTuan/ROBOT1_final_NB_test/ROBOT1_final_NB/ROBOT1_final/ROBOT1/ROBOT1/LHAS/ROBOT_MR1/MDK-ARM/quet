double calculateOverallMean(StaticArray *arr) {
    double rowMeans[ROWS], clusterData[ROWS], mean;
    int validRowCount;
    Cluster clusters[10]; // Gi? s? t?i da 10 c?m
    int i, k, j;

    validRowCount = 0;
    for (i = 0; i < ROWS; i++) {
        rowMeans[i] = removeOutliersAndCalculateMean(arr->data[i], MAX_COLS);
        if (rowMeans[i] > 0) {
            validRowCount++;
        }
    }

    // S? c?m
    k = 4; // Có th? thay d?i
    kMeansClustering(rowMeans, k, clusters);
    //----------------------------------------------------------

    for (i = 0; i < k; i++) {
        // Sao chép d? li?u c?a c?m
        printf("Cluster Index %d: ", i + 1);
        for (j = 0; j < clusters[i].count; j++) {
            clusterData[j] = rowMeans[clusters[i].indices[j]];
            printf("%d    ", clusters[i].indices[j]);
        }
        printf("\n");
        // In du lieu ra kiem tra
        printf("Cluster data   : ");
        for (j = 0; j < clusters[i].count; j++) {
            printf("%.2f ", clusterData[j]);
        }
        printf("\n");

        // Tính trung bình sau khi lo?i b? ngo?i l?
        mean = removeOutliersAndCalculateMean(clusterData, clusters[i].count);
        
        printf("Cluster %d , Size: %d, mean: %d, Mean : %.2f):\n", i + 1, clusters[i].count, clusters[i].centroid, mean);

        if (clusters[i].count > 10) printf("...");
        printf("\n\n");
    }


    return 0;
}
