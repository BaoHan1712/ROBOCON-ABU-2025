#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <time.h>

#define ROWS 1000
#define MAX_COLS 50
#define MAX_GAP 20

typedef struct {
    double data[ROWS][MAX_COLS];  
    int nextIndex[ROWS];                 
} StaticArray;

typedef struct {
    int indices[ROWS]; 
    int count;         
    int centroid;
} Cluster;

StaticArray arrLaser;
//--------------------------------------------------------------------------------
int compare(const void *a, const void *b) {
    double diff = *(double *)a - *(double *)b;
    return (diff > 0) - (diff < 0);
}

void initStaticArray(StaticArray *arr) {
    int i, j;
    for (i = 0; i < ROWS; i++) {
        arr->nextIndex[i] = 0; 
        for (j = 0; j < MAX_COLS; j++) {
            arr->data[i][j] = 0;
        }
    }
}

void addElement(StaticArray *arr, int rowIndex, double value) {
    if (rowIndex < 0 || rowIndex >= ROWS) return;
    if (value == 0) return;
    arr->data[rowIndex][arr->nextIndex[rowIndex]] = value;
    arr->nextIndex[rowIndex] = (arr->nextIndex[rowIndex] + 1) % MAX_COLS;
}

double distance(int index, double centroid_index) {
    return fabs(index - centroid_index);
}

int initCentroids(int indices[], int valid_count, double centroids_index[]) {
    int i, k = 1; // B?t d?u v?i 1 c?m
    double gap_threshold = MAX_GAP; // Ngu?ng kho?ng cách d? tách c?m

    // S?p x?p indices theo giá tr?
    for (i = 0; i < valid_count - 1; i++) {
        for (int j = i + 1; j < valid_count; j++) {
            if (indices[i] > indices[j]) {
                int temp = indices[i];
                indices[i] = indices[j];
                indices[j] = temp;
            }
        }
    }

    // Tìm các kho?ng tr?ng l?n d? xác d?nh s? c?m
    centroids_index[0] = indices[0]; // Tâm c?m d?u tiên
    for (i = 1; i < valid_count; i++) {
        if (indices[i] - indices[i-1] > gap_threshold) {
            centroids_index[k] = indices[i]; // Thêm tâm c?m m?i
            k++;
        }
    }

    return k; // Tr? v? s? c?m th?c t?
}

//--------------------------------------------------------------------------------
double removeOutliersAndCalculateMean(double arr[], int arrMax) {
    double nonZeroArr[ROWS];
    int nonZeroCount;
    double Q1, Q3, IQR, lowerBound, upperBound, sum;
    int validCount;
    int i;

    nonZeroCount = 0;
    for (i = 0; i < arrMax; i++) {
        if (arr[i] != 0) {
            nonZeroArr[nonZeroCount++] = arr[i];
        }
    }

    if (nonZeroCount == 0) {
        return 0;
    }

    qsort(nonZeroArr, nonZeroCount, sizeof(double), compare);

    Q1 = nonZeroArr[nonZeroCount / 4];
    Q3 = nonZeroArr[(3 * nonZeroCount) / 4];
    IQR = Q3 - Q1;
    lowerBound = Q1 - 1.5 * IQR;
    upperBound = Q3 + 1.5 * IQR;

    sum = 0.0;
    validCount = 0;
    for (i = 0; i < nonZeroCount; i++) {
        if (nonZeroArr[i] >= lowerBound && nonZeroArr[i] <= upperBound) {
            sum += nonZeroArr[i];
            validCount++;
        }
    }

    return validCount > 0 ? sum / validCount : 0.0;;
}

void kMeansClustering(double data[ROWS], int k, Cluster clusters[]) {
    int indices[ROWS]; // M?ng luu các index c?a di?m h?p l?
    double centroids_index[10]; // Gi? s? t?i da 10 c?m
    int assignments[ROWS], valid_count, i, j, iter, changed, closestCluster;
    double minDist, dist;

    // L?c các di?m h?p l? (giá tr? != 0)
    valid_count = 0;
    for (i = 0; i < ROWS; i++) {
        if (data[i] != 0.0) { // Gi? s? giá tr? 0 là không h?p l?
            indices[valid_count] = i;
            valid_count++;
        }
    }

    if (valid_count == 0) {
        printf("No valid data points found!\n");
        return;
    }

    // Kh?i t?o tâm c?m d?a trên kho?ng tr?ng
    k = initCentroids(indices, valid_count, centroids_index);

    // Kh?i t?o c?m
    for (i = 0; i < k; i++) {
        clusters[i].count = 0;
        clusters[i].centroid = -1; // Kh?i t?o centroid index là -1 (chua có)
    }

    // L?p K-means
    for (iter = 0; iter < 100; iter++) {
        changed = 0;

        // Gán di?m vào c?m g?n nh?t
        for (i = 0; i < valid_count; i++) {
            minDist = INFINITY;
            closestCluster = 0;
            for (j = 0; j < k; j++) {
                dist = distance(indices[i], centroids_index[j]);
                if (dist < minDist) {
                    minDist = dist;
                    closestCluster = j;
                }
            }
            assignments[i] = closestCluster;
        }

        // C?p nh?t tâm c?m
        for (i = 0; i < k; i++) {
            clusters[i].count = 0;
            centroids_index[i] = 0.0;
            clusters[i].centroid = -1;
        }

        for (i = 0; i < valid_count; i++) {
            int c = assignments[i];
            centroids_index[c] += indices[i];
            clusters[c].indices[clusters[c].count] = indices[i];
            clusters[c].count++;
        }

        for (i = 0; i < k; i++) {
            if (clusters[i].count > 0) {
                // Tính giá tr? trung bình c?a các index
                double avg = centroids_index[i] / clusters[i].count;
                // Tìm di?m có index g?n nh?t v?i giá tr? trung bình
                minDist = INFINITY;
                int bestIndex = -1;
                for (j = 0; j < clusters[i].count; j++) {
                    dist = fabs(data[clusters[i].indices[j]] - avg);
                    if (dist < minDist) {
                        minDist = dist;
                        bestIndex = clusters[i].indices[j];
                    }
                }
                clusters[i].centroid = bestIndex; // Luu index c?a tâm
                centroids_index[i] = avg; // Gi? nguyên giá tr? trung bình cho l?n l?p ti?p theo
            }
        }

        // Ki?m tra h?i t?
        changed = 0;
        for (i = 0; i < valid_count; i++) {
            minDist = INFINITY;
            closestCluster = 0;
            for (j = 0; j < k; j++) {
                dist = distance(indices[i], centroids_index[j]);
                if (dist < minDist) {
                    minDist = dist;
                    closestCluster = j;
                }
            }
            if (closestCluster != assignments[i]) {
                changed = 1;
                assignments[i] = closestCluster;
            }
        }

        if (!changed) break; // H?i t?
    }
}

